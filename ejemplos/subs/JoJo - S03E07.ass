Dialogue: 0,0:09:31.61,0:09:31.73,SFXEchoes1,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz338.7\pos(1234.667,64)}¡Plaf!
Dialogue: 0,0:09:32.79,0:09:34.38,JoJo-main,Fake,0,0,0,,A ver…
Dialogue: 0,0:09:33.00,0:09:33.12,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1094.665,-2.667)}¡Plaf!
Dialogue: 0,0:09:33.12,0:09:33.25,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1094.665,30.666)}¡Plaf!
Dialogue: 0,0:09:33.25,0:09:33.37,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1094.665,53.333)}¡Plaf!
Dialogue: 0,0:09:33.37,0:09:33.50,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1091.998,30.666)}¡Plaf!
Dialogue: 0,0:09:33.50,0:09:33.62,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1089.331,3.999)}¡Plaf!
Dialogue: 0,0:09:33.62,0:09:33.75,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1088.798,-14.4)}¡Plaf!
Dialogue: 0,0:09:33.75,0:09:33.87,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1089.331,-5.333)}¡Plaf!
Dialogue: 0,0:09:33.87,0:09:34.00,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1089.331,32)}¡Plaf!
Dialogue: 0,0:09:34.00,0:09:34.12,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1090.664,52)}¡Plaf!
Dialogue: 0,0:09:34.12,0:09:34.25,SFXEchoes2,AAAAAAAAAAAAAAAAAAA,0,0,0,,{\frz343.8\pos(1089.331,30.667)}¡Plaf!
